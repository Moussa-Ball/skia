+// ── DirectComposition helpers ─────────────────────────────────────────────────
+//
+// InitDComp wires a freshly-created composition swap chain into a DComp visual
+// tree so DWM composites it without observing Win32 resize events.
+//
+// Visual tree:
+//   IDCompositionTarget (HWND root, topmost)
+//     └─ IDCompositionVisual
+//          └─ IDXGISwapChain1 (content)
+//
+// The visual has no explicit transform or clip — it maps 1:1 to the window at
+// all times.  When ResizeBuffers is called the content dimensions update and
+// DWM adjusts on the next composite cycle cleanly.
+
+MaybeError SwapChain::InitDComp(HWND hwnd, IDXGISwapChain1* sc) {
+    // DCompositionCreateDevice(nullptr) creates a software DComp device backed
+    // by its own DXGI device.  This is independent of the D3D12 rendering device
+    // and works on any Windows 8+ / 10 system.
+    DAWN_TRY(CheckHRESULT(
+        DCompositionCreateDevice(nullptr, IID_PPV_ARGS(&mDCompDevice)),
+        "DCompositionCreateDevice"));
+
+    // Attach the DComp visual tree to the HWND.  topmost=TRUE places it above
+    // the default visual layer (correct for a full-window renderer).
+    DAWN_TRY(CheckHRESULT(
+        mDCompDevice->CreateTargetForHwnd(hwnd, TRUE, &mDCompTarget),
+        "IDCompositionDevice::CreateTargetForHwnd"));
+
+    DAWN_TRY(CheckHRESULT(
+        mDCompDevice->CreateVisual(&mDCompVisual),
+        "IDCompositionDevice::CreateVisual"));
+
+    // Point the visual at the swap chain.
+    DAWN_TRY(CheckHRESULT(
+        mDCompVisual->SetContent(sc),
+        "IDCompositionVisual::SetContent"));
+
+    DAWN_TRY(CheckHRESULT(
+        mDCompTarget->SetRoot(mDCompVisual.Get()),
+        "IDCompositionTarget::SetRoot"));
+
+    // Commit the initial visual tree so DWM starts compositing this window.
+    DAWN_TRY(CheckHRESULT(
+        mDCompDevice->Commit(),
+        "IDCompositionDevice::Commit (initial)"));
+
+    mUseDComp = true;
+    return {};
+}
+
+void SwapChain::TeardownDComp() {
+    mDCompVisual  = nullptr;
+    mDCompTarget  = nullptr;
+    mDCompDevice  = nullptr;
+    mUseDComp     = false;
+}
+
 }  // namespace dawn::native::d3d
